# Extract the 'Precursors_log' assay
precursors_log <- assay(scp[["Precursors_log"]])
# Define the quantile thresholds
lower_quantile <- 0.01
upper_quantile <- 0.99
# Remove values below the 0.01 quantile and above the 0.99 quantile
filtered_precursors_log <- apply(precursors_log, 1, function(x) {
quantiles <- quantile(x, probs = c(lower_quantile, upper_quantile), na.rm = TRUE)
x[x < quantiles[1] | x > quantiles[2]] <- NA
return(x)
})
