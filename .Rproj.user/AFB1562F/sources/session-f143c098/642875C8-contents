L <- makeContrast(c("ab.conditionWT1=0", 
                    "ab.conditionWT2=0"),
                  parameterNames = c(
                      "(Intercept)",
                      "ab.conditionWT1",
                      "ab.conditionWT2")) # Contrast matrix

pe <- hypothesisTest(object = pe, i = "Proteins", contrast = L)

