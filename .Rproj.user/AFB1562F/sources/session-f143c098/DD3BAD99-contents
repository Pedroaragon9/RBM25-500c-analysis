# Intial clean up and data preparation
To accomodate the scp package requirements for analysis, the data was reshaped and the metadata was added to the quantitative data.
```{r}
#Import quantitative tables 
SN.PEPquant <- read.delim("PorseLab_SSO_BBO_500c_hBM_Report_PEPQuant (Normal).tsv")
SN.PEPquant %>% filter(PG.Genes == "TET2") %>%
distinct(PEP.StrippedSequence) %>% view()

#define the cell type from the file name column.
SN.PEPquant <- merge(SN.PEPquant, stats[, c("filename", "sample", "Cell.Type")], 
                     by.x = "R.FileName", by.y = "filename", all.x = TRUE)


#reshape the data to generate the input table and sample table required for the scp package
inputCols <- c("FG.MS1Quantity", "R.FileName", "PG.Genes", "PG.ProteinAccessions", "PG.IsSingleHit", "PEP.StrippedSequence", "FG.Charge")
sampleCols <- c("R.FileName", "sample", "Cell.Type")

sampleData <- SN.PEPquant %>% 
  select(all_of(sampleCols)) %>%
  distinct() %>%
  mutate(Quant.Col = "FG.MS1Quantity")

inputData <- SN.PEPquant %>%
  select(all_of(inputCols))
```

## OOP using scp
```{r}
scp <- readSCP(featureData = inputData,
               colData = sampleData,
               batchCol = "R.FileName",
               channelCol = "Quant.Col",
               removeEmptyCols = TRUE)

assay_names <- names(scp)

# Normalize the assays from 1 to 215 
# Is this appropriate?, maybe there are smater ways to do this, but until then Ill forloop it 
for (i in 1:36) {
  # Get the name of the current assay
  assay_name <- assay_names[i]
  
  #Normalize the current assay
  scp <- normalizeSCP(scp, assay_name, name = paste0("norm_Precursor", assay_name), method = "div.median")
}

#Aggregate the features over the assays
scp <- aggregateFeaturesOverAssays(scp,
                                  i = grep("norm_Precursor", names(scp)),    ## assays to be aggregated
                                  name = paste0("peptides", grep("norm_Precursor", names(scp))), ## new assay name
                                  fcol = "PEP.StrippedSequence",    ## what to aggregate
                                  fun = colMedians)                   ## how to aggregate

scp <- zeroIsNA(scp, i = grep("peptides", names(scp)))
scp <- infIsNA(scp,i = grep("peptides", names(scp)))

scp <- joinAssays(scp,
                    i = grep("peptides", names(scp)),
                    name = "Peptides")
```

## Quality control and completness   
```{r}
isIdentified <- function(x) colSums(!is.na(x)) != 0

scpNA <- aggregateFeaturesOverAssays(scp,
                                  i = grep("norm_Precursor", names(scp)),    ## assays to be aggregated
                                  name = paste0("MV_proteins", grep("norm_Precursor", names(scp))), ## new assay name
                                  fcol = "PG.ProteinAccessions",    ## what to aggregate
                                  fun = isIdentified)                                  

scpNA <- joinAssays(scpNA,
                    i = grep("MV_proteins", names(scpNA)), 
                        name = "prot_id") 

isMissing_prot <- is.na(assay(scpNA[["prot_id"]]))
assay(scpNA[["prot_id"]])[isMissing_prot] <- FALSE

#Here sensitivity is defined as the number of distinct peptide identifications.
#Local sensitivity reported as the number of features per cell.
#Total sensitivity reported as the number of features across all cells within a celltype.
prot_sensitivity_summary <- reportMissingValues(scpNA, "prot_id", by = scpNA$Cell.Type)
prot_sensitivity_summary <- rownames_to_column(prot_sensitivity_summary, var = "Cell.Type")



p1 <- ggplot(prot_sensitivity_summary, aes(x = Completeness, y = LocalSensitivityMean, color = Cell.Type, size = NumberCells)) +
        geom_point() +
        geom_linerange(aes(ymin = LocalSensitivityMean - LocalSensitivitySd, ymax = LocalSensitivityMean + LocalSensitivitySd), size = 1) +
        scale_color_manual("Population",
                        values = c("#6aa84f", "#d98e47", "#3d85c6", "#bf63bf", "#e89691",
                                    "#FF1493", "#20B2AA", "#FF4500", "#b3cde0", "#006666", "#a7adba", "#FF69B4"),
                        guide = "none") +
        labs(x = "Completeness [%]", y = "Average protein features per Population", size = "Number of replicates", color = "Population") +
        theme_minimal()
  

#Evaluate similarity/consistency of identifications across celltypes
ji_prot <- jaccardIndex(scpNA, "prot_id", by = scpNA$Cell.Type)

medians <- ji_prot %>%
  group_by(by) %>%
  summarise(median = median(jaccard))

p2 <- ggplot(ji_prot, aes(x = jaccard, fill = by)) +
  geom_histogram(alpha = 0.7) +
  geom_vline(data = medians, aes(xintercept = median), linetype = "dashed", color = "#5b5b5b") +
  geom_text_repel(data = medians, aes(x = median, y = 0, label = paste("Median:", round(median, 2))), nudge_y = 0.5) +  
  facet_grid(by ~ ., scales = "free_y") +
  scale_fill_manual("Population",
                    values = c("#6aa84f", "#d98e47", "#3d85c6", "#bf63bf", "#e89691",
                                "#FF1493", "#20B2AA", "#FF4500", "#b3cde0", "#006666", "#a7adba", "#FF69B4")) +
  labs(x = "Jaccard Index", y = "Count") +
  theme_minimal() +
  theme(strip.text = element_blank())


csc_prot <- cumulativeSensitivityCurve(scpNA, "prot_id", by = scpNA$sample,
                                  niters = 10, 
                                  nsteps = max(36))

pCSC_prot <- ggplot(csc_prot) +
  aes(x = SampleSize, y = Sensitivity) +
  geom_point(size = 3, alpha = 0.7, color = "#005b96") +
  labs(x = "Number of cells", y = "Sensitivity") +
  theme_minimal() 

predCSC_prot <- predictSensitivity(csc_prot, nSample = 1:length(unique(csc_prot$SampleSize)))

#Add the maximal predicted sensitivity to the plot
prot_maxSensitivity <- predictSensitivity(csc_prot, nSamples = Inf)

prot_maxSensitivity <- prot_maxSensitivity %>%
  dplyr::select(-SampleSize) %>%
  rename(CellType = by, "Max. predicted sensitivity" = Sensitivity) %>%
  dplyr::select(CellType, "Max. predicted sensitivity", everything()) %>%
  mutate(CellType = "hBM")


p3 <- pCSC_prot + 
        geom_line(data = predCSC_prot, color = "#ffad60", size = 1.5) +
        geom_table(data = prot_maxSensitivity, 
                  aes(x = Inf, y = -Inf, label = list(prot_maxSensitivity)), 
                  hjust = 1, vjust = 0) +
                  theme(legend.position = "none") 
```

# Peptide centric normalization and imputation 
```{r}
#We also remove peptides that contain to many missing values to work with  
scp <- filterNA(scp,
                i = "Peptides",
                pNA = 0.99)

#We will normalize the data by apply a median shift of the total intensity across cells, as implemented in the scanpy
sf <- colSums(assay(scp, "Peptides"), na.rm = TRUE)
sf <- sf / median(sf)
scp <- sweep(scp, MARGIN = 2, STATS = sf, FUN = "/",
              i = "Peptides", name = "Peptides_norm")

#We perform the log transformation after normalizeing the data
scp <- logTransform(scp, i = "Peptides_norm", name = "peptides_log")
# Impute missing values using KNN
# alternatively: imputeKnnSCoPE2(object, i, name = "KNNimputedAssay", k = 3) 
scp <- impute(scp,
              i = "peptides_log",
              method = "knn",
              k = 3, rowmax = 1, colmax= 1,
              maxp = Inf, rng.seed = 1234, name = "Peptides_imp")

```

## Protein aggregation and normalisation
```{r}
#This function calculates the robust summarisation for each feature (protein).
#Note that the function assumes that the intensities in input e are already log-transformed.
scp <- aggregateFeatures(scp, "Peptides_imp", "PG.ProteinAccessions", name = "Proteins", fun = MsCoreUtils::robustSummary) #Check if this is ok
#scp <- aggregateFeatures(scp,  "Peptides_imp", "PG.ProteinAccessions", name = "Proteins_med", fun = colMedians) #Check if this is ok

#We now perform centering followed by scalling of the data to unit variance
means <- rowMeans(assay(scp, "Proteins"))
scp <- sweep(scp, MARGIN = 1, STATS = means, FUN = "-",
             i = "Proteins", name = "Proteins_centered")
stds <- rowSds(assay(scp, "Proteins_centered"))
scp <- sweep(scp, MARGIN = 1, STATS = stds, FUN = "/",
             i = "Proteins_centered", name = "Proteins_scaled")
            
scp[["Proteins"]]
plot(scp, interactive = TRUE) 
```

