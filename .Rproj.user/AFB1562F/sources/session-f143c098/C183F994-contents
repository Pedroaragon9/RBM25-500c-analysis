# Remove nM in cmpd.conc
flowjo.table_D1$cmpd.conc <- gsub("nM", "", flowjo.table_D1$cmpd.conc)

#Make the cmpd.conc column numeric
flowjo.table_D1$cmpd.conc <- as.numeric(flowjo.table_D1$cmpd.conc)

#Average the DMSO controls
UT.ctrl <- DMSO.ctrls %>%
