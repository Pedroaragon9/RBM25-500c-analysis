filter_outliers <- function(df) {
  if (nrow(df) < 3) return(df)  # Return unchanged if less than 3 rows
  
  # Calculate median and IQR
  median_value <- median(df$viable.cells)
  iqr_value <- IQR(df$viable.cells)
  
  # Define lower and upper bounds for outliers
  lower_bound <- median_value - 1.5 * iqr_value
  upper_bound <- median_value + 1.5 * iqr_value
  
  # Filter outliers
  df_filtered <- df[df$viable.cells >= lower_bound & df$viable.cells <= upper_bound, , drop = FALSE]
  
  return(df_filtered)
}

