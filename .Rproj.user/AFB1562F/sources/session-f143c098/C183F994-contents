#remove outliers
grouped <- split(IC.50_D1, list(IC.50_D1$Cmpd, IC.50_D1$cmpd.conc))


filter_outliers <- function(df) {
  if (nrow(df) < 3) return(df)  # Return unchanged if less than 3 rows
  
  # Calculate median and IQR
  median_value <- median(df$viable.cells)
  iqr_value <- IQR(df$viable.cells)
  
  # Define lower and upper bounds for outliers
  lower_bound <- median_value - 1.5 * iqr_value
  upper_bound <- median_value + 1.5 * iqr_value
  
  # Filter outliers
  df_filtered <- df[df$viable.cells >= lower_bound & df$viable.cells <= upper_bound, , drop = FALSE]
  
  return(df_filtered)
}

# Step 3: Apply the filter_outliers function to each group
filtered_groups <- lapply(grouped, filter_outliers)

# Step 4: Combine filtered groups back into a single data frame
filtered_IC.50_D1 <- do.call(rbind, filtered_groups)

#Apply the filter_outliers function to each group
filtered_groups <- lapply(grouped, filter_outliers)

#Combine filtered groups back into a single data frame
