#filtered_IC.50_D1 <- IC.50_D1


#Calculate IC50 values for each condition and cell type inc. all cells
IC.50.long_D1 <- filtered_IC.50_D1 %>% 
  gather(key = "Cell.Type", value = "Viability.percentage", 2:6)
  
cmpd.values <- unique(IC.50.long_D1$Cmpd)
cell.type.values <- unique(IC.50.long_D1$Cell.Type)

IC50.list_D1 <- list()
for (cmpd in cmpd.values) {
  for (cell_type in cell.type.values) {

    filtered_data_D1 <- IC.50.long_D1 %>%
      filter(Cmpd == cmpd, Cell.Type == cell_type)
    
    if (nrow(filtered_data_D1) > 0) {  
      
      fitted_curve_D1 <- drm(formula = Viability.percentage ~ cmpd.conc,
                          data = filtered_data_D1,
                          fct = LL.4())
      
      Einf <- fitted_curve_D1$coefficients[2]
      E0 <- fitted_curve_D1$coefficients[3]
      EC50 <- fitted_curve_D1$coefficients[4]
      H <-  fitted_curve_D1$coefficients[1]
      IC50 <- exp(log((((Einf - E0) / (50 - E0)) - 1) * EC50**(-H)) / (-H))
      
      efficacy_metrics <- data.frame(c(E0, Einf, EC50, H, IC50))
      rownames(efficacy_metrics) <- c('E0', 'Einf', 'EC50', 'H', 'IC50')
      colnames(efficacy_metrics) <- 'Value'
      
      # Store the results in a list
      IC50.list_D1[[paste(cmpd, cell_type, sep = "-->")]] <- efficacy_metrics
    }
  }
}

#Extracte IC50 values only for the viable cells
IC50.all.cells_D1 <- data.frame(Cmpd = character(0), IC50 = numeric(0))
for (key in names(IC50.list_D1)) {
  if (grepl("viable.cells", key)) {
    cmpd <- sub("-->viable.cells", "", key)  # Extract the Cmpd name
    ic50_value <- IC50.list_D1[[key]]["IC50", "Value"]
    IC50.all.cells_D1 <- rbind(IC50.all.cells_D1, data.frame(Cmpd = cmpd, IC50 = ic50_value))
  }
}

IC50_annotation_data <- data.frame(
  Cmpd = IC50.all.cells_D1$Cmpd,
  IC50 = IC50.all.cells_D1$IC50,
  label = ifelse(is.na(IC50.all.cells_D1$IC50), "IC50 = NA",
                 ifelse(IC50.all.cells_D1$IC50 > 10^6, "IC50 = NA", paste("IC50 =", round(IC50.all.cells_D1$IC50, 2)))
  )
