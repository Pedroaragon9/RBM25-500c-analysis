BzCl.ctrls <- flowjo.table_D1[flowjo.table_D1$Cmpd %in% BzCl_wells, ]

# Remove DMSO and BzCl samples from flowjo.table
flowjo.table_D1 <- anti_join(flowjo.table_D1, DMSO.ctrls, by = "Sample")
flowjo.table_D1 <- anti_join(flowjo.table_D1, BzCl.ctrls, by = "Sample")

#Define drugs and consentrations
flowjo.table_D1$Cmpd <- gsub(" Aza.1000nM", " 1000nM Aza+Ven", flowjo.table_D1$Cmpd)


split_cmpd <- strsplit(flowjo.table_D1$Cmpd, "\\.")

# Extract compound and concentration
flowjo.table_D1$Cmpd <- sapply(split_cmpd, function(x) x[1])
flowjo.table_D1$cmpd.conc <- sapply(split_cmpd, function(x) {
  if (length(x) > 1) {
    x[2]
  } else {
    NA  # Handle cases where there's no concentration specified
  }
})

#Correct the combination treatment notation
replace_indices <- grepl("1000nM Aza\\+Ven", flowjo.table_D1$cmpd.conc)
flowjo.table_D1$Cmpd[grepl("1000nM Aza\\+Ven", flowjo.table_D1$cmpd.conc)] <- "1000nM Aza+Ven"
flowjo.table_D1$cmpd.conc[replace_indices] <- gsub("1000nM Aza\\+Ven", "", flowjo.table_D1$cmpd.conc[replace_indices])
