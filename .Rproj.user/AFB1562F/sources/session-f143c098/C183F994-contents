  summarise(across(everything(), mean, na.rm = TRUE))

IC.50_D1 <- flowjo.table_D1 %>%
  group_by(Cmpd) %>%
  mutate(
    CD38.pos = (CD38.pos/UT.ctrl$CD38.pos)*100,
