# Peptide centric normalization and imputation 
```{r}
# Aggregate precursor features to peptides
scp <- aggregateFeatures(scp,
                         i = "lognorm_Precursors_quantiles",
                         fcol = "PEP.StrippedSequence",
                         name = "Peptides",
                         fun = "robustSummary")

scp <- zeroIsNA(scp, i = "Peptides")
scp <- infIsNA(scp,i = "Peptides")

#We also remove peptides that contain to many missing values to work with  
scp <- filterNA(scp,
                i = "Peptides",
                pNA = 0.99)

#We will normalize the data by apply a median shift of the total intensity across cells, as implemented in the scanpy
#Check if normalization is needed
sf <- colSums(assay(scp, "Peptides"), na.rm = TRUE)
sf <- sf / median(sf)
scp <- sweep(scp, MARGIN = 2, STATS = sf, FUN = "/",
              i = "Peptides", name = "Peptides_norm")

par(mfrow = c(1, 2))
limma::plotDensities(assay(scp[["Peptides"]]), legend = FALSE)
limma::plotDensities(assay(scp[["Peptides_norm"]]), legend = FALSE)

scp <- impute(scp,
              i = "Peptides",
              method = "knn",
              k = 3, rowmax = 1, colmax= 1,
              maxp = Inf, rng.seed = 1234, name = "Peptides_imp")
```

## Protein aggregation and normalisation
```{r}
#This function calculates the robust summarisation for each feature (protein).
#Note that the function assumes that the intensities in input e are already log-transformed.
scp <- aggregateFeatures(scp,
                         "Peptides_imp",
                         "PG.ProteinAccessions",
                         name = "Proteins",
                         fun = MsCoreUtils::robustSummary) #Check if this is ok
#scp <- aggregateFeatures(scp,  "Peptides_imp", "PG.ProteinAccessions", name = "Proteins_med", fun = colMedians) #Check if this is ok
limma::plotDensities(assay(scp[["Proteins"]]), legend = FALSE)


#We now perform centering followed by scalling of the data to unit variance
means <- rowMeans(assay(scp, "Proteins"))
scp <- sweep(scp, MARGIN = 1, STATS = means, FUN = "-",
             i = "Proteins", name = "Proteins_centered")
stds <- rowSds(assay(scp, "Proteins_centered"))
scp <- sweep(scp, MARGIN = 1, STATS = stds, FUN = "/",
             i = "Proteins_centered", name = "Proteins_scaled")
par(mfrow = c(1, 2))
limma::plotDensities(assay(scp[["Proteins_scaled"]]), legend = FALSE)
limma::plotDensities(assay(scp[["Proteins"]]), legend = FALSE)
plot(scp, interactive = TRUE) 
```

